# Required - from the Discord Developer Portal (https://discord.com/developers/applications)
DISCORD_TOKEN=your-bot-token-here
CLIENT_ID=your-application-id-here

# Optional - only needed for `npm run deploy` to a single test server (instant command registration).
# Leave empty to register globally (takes up to 1 hour to propagate).
GUILD_ID=

# Optional - your Discord user ID, unlocks /staff owner commands
OWNER_ID=

# Optional integrations (bot works fine without them; those commands will say they are not configured)
LASTFM_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
OPENAI_API_KEY=
